# ==========================================
# Stars & Telegram Premium Shop Bot - Config
# ==========================================
# Ushbu faylni .env nomi bilan nusxalang:
# cp .env.example .env

# 1. Telegram Bot sozlamalari
# @BotFather dan olingan bot tokeni
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Bot adminlarining Telegram ID lari (vergul bilan ajratilgan)
ADMIN_USER_ID=123456789

# Qo'llab-quvvatlash (Support) username (masalan: your_support)
SUPPORT_USERNAME=support

# 2. Fragment API (Telegram Stars & Premium sotib olish)
# fragment-api.uz yoki api.fragment-api.space
FRAGMENT_API_URL=https://api.fragment-api.space
FRAGMENT_API_KEY=your_fragment_api_key_here

# Rejim: kyc yoki no_kyc
FRAGMENT_API_MODE=no_kyc
FRAGMENT_PAYMENT_METHOD=ton

# TON hamyon mnemonikasi (12 yoki 24 so'z, no_kyc bo'lsa ixtiyoriy)
FRAGMENT_WALLET_MNEMONIC=

# 3. TON to'lovlarini qabul qilish (Kripto)
TON_WALLET_ADDRESS=EQ...your_ton_wallet_address_here
TONCENTER_API_KEY=

# 4. Humo / UzCard to'lovlari (O'zbekiston kartalari)
HUMO_CARD_NUMBER=9860000000000000
HUMO_CARD_HOLDER=ISM FAMILIYA
USD_TO_UZS_RATE=12900

# Telethon (Bank SMSlarini tinglovchi bot uchun - ixtiyoriy)
TG_API_ID=
TG_API_HASH=
NOTIFICATION_BOT_USERNAME=@humo_sms_bot
TELETHON_SESSION_STRING=

# 5. Narxlar va limitlar
MIN_STARS_AMOUNT=50
MAX_STARS_AMOUNT=50000
ORDER_TIMEOUT_MINUTES=15
SERVICE_COMMISSION_PERCENT=5.0
USD_RUB_RATE=100.0

# 6. Tizim
DATABASE_PATH=stars_bot.db
BOT_VERSION=2.0
